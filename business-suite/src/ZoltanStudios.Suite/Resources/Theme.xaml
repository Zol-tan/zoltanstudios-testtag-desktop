<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light, business-software palette. Deliberately restrained: this is a
         tool that gets used for hours, not a marketing page. -->
    <SolidColorBrush x:Key="AppBackground" Color="#F8FAFC" />
    <SolidColorBrush x:Key="ChromeBrush"   Color="#FFFFFF" />
    <SolidColorBrush x:Key="SidebarBrush"  Color="#F1F5F9" />
    <SolidColorBrush x:Key="BorderBrush"   Color="#E2E8F0" />
    <SolidColorBrush x:Key="HeadingText"   Color="#0F172A" />
    <SolidColorBrush x:Key="BodyText"      Color="#334155" />
    <SolidColorBrush x:Key="MutedText"     Color="#64748B" />
    <SolidColorBrush x:Key="FaintText"     Color="#94A3B8" />
    <SolidColorBrush x:Key="AccentBrush"   Color="#2563EB" />
    <SolidColorBrush x:Key="OkBrush"       Color="#059669" />
    <SolidColorBrush x:Key="WarnBrush"     Color="#D97706" />
    <SolidColorBrush x:Key="BadBrush"      Color="#DC2626" />

    <Style TargetType="TreeViewItem">
        <Setter Property="Padding" Value="4,5" />
        <Setter Property="Foreground" Value="{StaticResource BodyText}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource HeadingText}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource MutedText}" />
        <Setter Property="Margin" Value="0,0,0,18" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</ResourceDictionary>
