<Window x:Class="ZoltanStudios.Suite.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZoltanStudios Business Suite"
        Height="800" Width="1280"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}">

    <DockPanel>

        <!-- ============================= Menu bar ============================= -->
        <Menu DockPanel.Dock="Top" Padding="6,4" FontSize="12.5" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <MenuItem Header="_File">
                <MenuItem Header="_New Test &amp; Tag Job"  InputGestureText="Ctrl+N" Click="NewJob_Click" />
                <MenuItem Header="New _Client"              Click="NewClient_Click" />
                <MenuItem Header="New _Invoice"             Click="NewInvoice_Click" />
                <Separator />
                <MenuItem Header="_Import Backup…"          Click="Import_Click" />
                <MenuItem Header="_Export Backup…"          Click="Export_Click" />
                <Separator />
                <MenuItem Header="E_xit"                    InputGestureText="Alt+F4" Click="Exit_Click" />
            </MenuItem>

            <MenuItem Header="_Edit">
                <MenuItem Header="_Find…" InputGestureText="Ctrl+F" Click="Find_Click" />
            </MenuItem>

            <MenuItem Header="_View">
                <MenuItem x:Name="MenuSidebar" Header="_Navigation Pane" IsCheckable="True"
                          IsChecked="True" Click="ToggleSidebar_Click" />
                <Separator />
                <MenuItem Header="_Dashboard"     Tag="dashboard" Click="Navigate_Click" />
                <MenuItem Header="Test &amp; Tag _App" Tag="webapp" Click="Navigate_Click" />
                <MenuItem Header="_Test &amp; Tag Jobs" Tag="testtag"  Click="Navigate_Click" />
                <MenuItem Header="_Clients"       Tag="clients"   Click="Navigate_Click" />
                <MenuItem Header="_Invoices"      Tag="invoices"  Click="Navigate_Click" />
                <MenuItem Header="C_alendar"      Tag="calendar"  Click="Navigate_Click" />
                <MenuItem Header="_Projects"      Tag="projects"  Click="Navigate_Click" />
                <MenuItem Header="_Messages"      Tag="messages"  Click="Navigate_Click" />
                <MenuItem Header="Q_uotes"        Tag="quotes"    Click="Navigate_Click" />
                <MenuItem Header="API _Tokens"    Tag="tokens"    Click="Navigate_Click" />
            </MenuItem>

            <MenuItem Header="_Sync">
                <MenuItem Header="Sync _Now"        InputGestureText="F5" Click="SyncNow_Click" />
                <MenuItem Header="Work _Offline"    IsCheckable="True" x:Name="MenuOffline"
                          Click="ToggleOffline_Click" />
                <Separator />
                <MenuItem Header="Sync _Settings…"  Click="SyncSettings_Click" />
                <MenuItem Header="Sign _Out"        Click="SignOut_Click" />
            </MenuItem>

            <MenuItem Header="_Tools">
                <MenuItem Header="_Tester Defaults…"  Click="TesterDefaults_Click" />
                <MenuItem Header="_Pricing…"          Click="Pricing_Click" />
                <MenuItem Header="Appliance _Library…" Click="Appliances_Click" />
                <Separator />
                <MenuItem Header="_Quote Calculator" Tag="quote" Click="Navigate_Click" />
                <MenuItem Header="_3D Printing Quote" Tag="printquote" Click="Navigate_Click" />
                <MenuItem Header="_Filament Stock"    Tag="filament" Click="Navigate_Click" />
            </MenuItem>

            <MenuItem Header="_Parts">
                <MenuItem Header="_Stock"                Tag="parts"         Click="Navigate_Click" />
                <MenuItem Header="_Restock List"         Tag="parts.restock" Click="Navigate_Click" />
                <Separator />
                <MenuItem Header="_Add Part..."          Click="AddPart_Click" />
                <MenuItem Header="_Copy Restock List"    Click="CopyRestock_Click" />
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Header="AS/NZS 3760 _Reference"  Click="Reference_Click" />
                <MenuItem Header="_Wavecom TnT Guide"      Click="WavecomGuide_Click" />
                <Separator />
                <MenuItem Header="_About"                  Click="About_Click" />
            </MenuItem>
        </Menu>

        <!-- ============================ Status bar ============================ -->
        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,2">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource MutedText}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="SyncDot" Width="8" Height="8" Margin="0,0,6,0"
                             Fill="{StaticResource OkBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="SyncText" Text="Offline" Margin="0,0,12,0"
                               Foreground="{StaticResource MutedText}" />
                    <TextBlock x:Name="VersionText" Text="v0.3.0"
                               Foreground="{StaticResource FaintText}" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- ========================= Navigation pane ==========================
             Items are built in MainWindow.xaml.cs (BuildNav) from one list, so
             the sidebar, the menus and Navigate() can't disagree. -->
        <Border x:Name="Sidebar" DockPanel.Dock="Left" Width="236"
                Background="{StaticResource SidebarBrush}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="18,18,18,14">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38" Height="38" CornerRadius="10" Margin="0,0,11,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3B82F6" Offset="0" />
                                    <GradientStop Color="#7C3AED" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ZoltanStudios" FontSize="15" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="Business Suite" FontSize="11" Foreground="{StaticResource SidebarMuted}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Bottom" Padding="18,12" BorderBrush="{StaticResource SidebarHover}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="SideDot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                 Fill="{StaticResource SidebarMuted}" />
                        <TextBlock x:Name="SideStatus" Text="Offline" FontSize="11.5"
                                   Foreground="{StaticResource SidebarText}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="NavHost" Margin="0,2,0,12" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ========================== Content area ============================ -->
        <Grid>
            <ContentControl x:Name="ContentHost" />
            <!-- The built-in test and tag app lives here and is only hidden,
                 never torn down, so switching pages doesn't reload it. -->
            <ContentControl x:Name="WebHost" Visibility="Collapsed" />
        </Grid>

    </DockPanel>
</Window>
