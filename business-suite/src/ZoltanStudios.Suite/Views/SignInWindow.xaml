<Window x:Class="ZoltanStudios.Suite.Views.SignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect to zoltanstudios.au"
        Height="290" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource AppBackground}">
    <StackPanel Margin="22">
        <TextBlock Text="Connect to the server" FontSize="16" FontWeight="SemiBold"
                   Foreground="{StaticResource HeadingText}" Margin="0,0,0,4" />
        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedText}"
                   Margin="0,0,0,16"
                   Text="Sign in with your admin panel account. The app keeps working offline; this is only needed to sync." />

        <TextBlock Text="Email" FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,0,0,3" />
        <TextBox x:Name="EmailBox" Padding="7,5" Margin="0,0,0,10" />

        <TextBlock Text="Password" FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,0,0,3" />
        <PasswordBox x:Name="PasswordBox" Padding="7,5" Margin="0,0,0,10" />

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource BadBrush}" FontSize="12"
                   TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="Cancel" Width="86" Height="30" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button x:Name="OkButton" Content="Sign in" Width="86" Height="30"
                    IsDefault="True" Click="SignIn_Click" />
        </StackPanel>
    </StackPanel>
</Window>
