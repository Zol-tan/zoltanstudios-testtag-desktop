{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZoltanStudios Test and Tag",
  "version": "2.6.0",
  "identifier": "au.zoltanstudios.testtag",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "https://zoltanstudios.au/testtag-app.html",
        "title": "ZoltanStudios Test and Tag Records",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [],
      "dangerousDisableAssetCspModification": false
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "ZoltanStudios",
    "copyright": "ZoltanStudios",
    "category": "Business",
    "shortDescription": "Test and Tag compliance records",
    "longDescription": "AS/NZS 3760:2022 test and tag compliance records, certificates and generator inspection reports for ZoltanStudios.",
    "iOS": {
      "developmentTeam": null,
      "minimumSystemVersion": "13.0"
    }
  }
}
